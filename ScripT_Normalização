INSERT INTO RESPONSAVEL (NOME_RESPONSAVEL)
SELECT DISTINCT RESPONSAVEL FROM base_custos_clinica_2022_2025;

INSERT INTO STATUS_CUSTO (DESCRICAO_STATUS)
SELECT DISTINCT STATUS FROM base_custos_clinica_2022_2025;

-- 4. CARGA NA TABELA FATO RELACIONAL
--------------------------------------------------------------------
INSERT INTO CUSTO (
    ID_CUSTO,
    DATA_CUSTO,
    DESCRICAO,
    VALOR,
    ID_FORNECEDOR,
    ID_CATEGORIA,
    ID_CENTRO_CUSTO,
    ID_RESPONSAVEL,
    ID_STATUS
)
SELECT 
    S.ID_CUSTO,
    S.DATA_CUSTO,
    S.DESCRICAO,
    S.VALOR,
    F.ID_FORNECEDOR,
    C.ID_CATEGORIA,
    CC.ID_CENTRO_CUSTO,
    R.ID_RESPONSAVEL,
    ST.ID_STATUS
FROM base_custos_clinica_2022_2025 S
INNER JOIN FORNECEDOR F ON S.FORNECEDOR = F.NOME_FORNECEDOR
INNER JOIN CATEGORIA C ON S.CATEGORIA = C.NOME_CATEGORIA
INNER JOIN CENTRO_CUSTO CC ON S.CENTRO_CUSTO = CC.NOME_CENTRO_CUSTO
INNER JOIN RESPONSAVEL R ON S.RESPONSAVEL = R.NOME_RESPONSAVEL
INNER JOIN STATUS_CUSTO ST ON S.STATUS = ST.DESCRICAO_STATUS;

select *from dbo.CUSTO

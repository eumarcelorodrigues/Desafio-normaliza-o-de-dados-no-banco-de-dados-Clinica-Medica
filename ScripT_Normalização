
select * from dbo.base_custos_clinica_2022_2025

-- Padroniza textos (UPPERCASE e TRIM) para evitar duplicidades por caixa/espaço
UPDATE base_custos_clinica_2022_2025
SET 
    FORNECEDOR = UPPER(TRIM(FORNECEDOR)),
    CATEGORIA = UPPER(TRIM(CATEGORIA)),
    CENTRO_CUSTO = UPPER(TRIM(CENTRO_CUSTO)),
    DESCRICAO = UPPER(TRIM(DESCRICAO)),
    STATUS = UPPER(TRIM(STATUS)),
    RESPONSAVEL = UPPER(TRIM(RESPONSAVEL));

-- Trata valores nulos em atributos obrigatórios de dimensão
UPDATE base_custos_clinica_2022_2025 SET FORNECEDOR = 'NÃO INFORMADO' WHERE FORNECEDOR IS NULL;
UPDATE base_custos_clinica_2022_2025 SET CATEGORIA = 'NÃO INFORMADO' WHERE CATEGORIA IS NULL;
UPDATE base_custos_clinica_2022_2025 SET CENTRO_CUSTO = 'NÃO INFORMADO' WHERE CENTRO_CUSTO IS NULL;
UPDATE base_custos_clinica_2022_2025 SET RESPONSAVEL = 'NÃO INFORMADO' WHERE RESPONSAVEL IS NULL;

-- Padroniza o status para um domínio uniforme
UPDATE base_custos_clinica_2022_2025 SET STATUS = 'PAGO' WHERE STATUS IN ('PAGO', 'PAGO ');
UPDATE base_custos_clinica_2022_2025 SET STATUS = 'PENDENTE' WHERE STATUS IN ('PENDENTE', 'PENDENTE ');
UPDATE base_custos_clinica_2022_2025 SET STATUS = 'ATRASADO' WHERE STATUS IN ('ATRASADO', 'ATRASADO ');

-- 2. CRIAÇÃO DAS TABELAS NORMALIZADAS (DIMENSÕES & FATO)
--------------------------------------------------------------------
-- Tabela: FORNECEDOR
CREATE TABLE FORNECEDOR (
    ID_FORNECEDOR INT IDENTITY(1,1) PRIMARY KEY,
    NOME_FORNECEDOR VARCHAR(150) NOT NULL UNIQUE
);

-- Tabela: CATEGORIA
CREATE TABLE CATEGORIA (
    ID_CATEGORIA INT IDENTITY(1,1) PRIMARY KEY,
    NOME_CATEGORIA VARCHAR(100) NOT NULL UNIQUE
);

-- Tabela: CENTRO_CUSTO
CREATE TABLE CENTRO_CUSTO (
    ID_CENTRO_CUSTO INT IDENTITY(1,1) PRIMARY KEY,
    NOME_CENTRO_CUSTO VARCHAR(100) NOT NULL UNIQUE
);

-- Tabela: RESPONSAVEL
CREATE TABLE RESPONSAVEL (
    ID_RESPONSAVEL INT IDENTITY(1,1) PRIMARY KEY,
    NOME_RESPONSAVEL VARCHAR(150) NOT NULL UNIQUE
);

-- Tabela: STATUS_CUSTO
CREATE TABLE STATUS_CUSTO (
    ID_STATUS INT IDENTITY(1,1) PRIMARY KEY,
    DESCRICAO_STATUS VARCHAR(50) NOT NULL UNIQUE
);

-- Tabela Fato: CUSTO
CREATE TABLE CUSTO (
    ID_CUSTO INT PRIMARY KEY,
    DATA_CUSTO DATE NOT NULL,
    DESCRICAO VARCHAR(255) NULL,
    VALOR DECIMAL(18, 2) NOT NULL,
    ID_FORNECEDOR INT NOT NULL,
    ID_CATEGORIA INT NOT NULL,
    ID_CENTRO_CUSTO INT NOT NULL,
    ID_RESPONSAVEL INT NOT NULL,
    ID_STATUS INT NOT NULL,
    
    -- Definição de Integridade Referencial (Chaves Estrangeiras)
    CONSTRAINT FK_CUSTO_FORNECEDOR FOREIGN KEY (ID_FORNECEDOR) REFERENCES FORNECEDOR(ID_FORNECEDOR),
    CONSTRAINT FK_CUSTO_CATEGORIA FOREIGN KEY (ID_CATEGORIA) REFERENCES CATEGORIA(ID_CATEGORIA),
    CONSTRAINT FK_CUSTO_CENTRO_CUSTO FOREIGN KEY (ID_CENTRO_CUSTO) REFERENCES CENTRO_CUSTO(ID_CENTRO_CUSTO),
    CONSTRAINT FK_CUSTO_RESPONSAVEL FOREIGN KEY (ID_RESPONSAVEL) REFERENCES RESPONSAVEL(ID_RESPONSAVEL),
    CONSTRAINT FK_CUSTO_STATUS FOREIGN KEY (ID_STATUS) REFERENCES STATUS_CUSTO(ID_STATUS)
);


